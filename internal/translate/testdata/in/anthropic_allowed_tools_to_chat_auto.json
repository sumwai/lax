{
  "from": "anthropic",
  "to": "openai-chat",
  "kind": "request",
  "body": {
    "model": "m1",
    "max_tokens": 256,
    "messages": [{"role": "user", "content": "北京天气"}],
    "tools": [
      {"name": "weather", "description": "查天气", "input_schema": {"type": "object", "properties": {"city": {"type": "string"}}}}
    ],
    "tool_choice": {"type": "allowed_tools", "tools": [{"type": "tool", "name": "weather"}]}
  }
}
